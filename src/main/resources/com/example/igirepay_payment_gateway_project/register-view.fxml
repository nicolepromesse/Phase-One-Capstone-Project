<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.igirepay.lab3.javafxui.RegisterController"
           stylesheets="@styles.css"
           styleClass="root-pane">

    <VBox styleClass="login-card"
          alignment="CENTER"
          spacing="14"
          prefWidth="420"
          maxWidth="420">

        <padding>
            <Insets top="32" right="32" bottom="32" left="32"/>
        </padding>

        <!-- Branding -->
        <VBox alignment="CENTER" spacing="6">

            <Label text="💳"
                   style="-fx-font-size: 38px;"/>

            <Label text="IgirePay"
                   styleClass="brand-title"/>

            <Label text="Create Account"
                   styleClass="brand-sub"/>

        </VBox>

        <Separator/>

        <!-- Form -->
        <VBox spacing="10">

            <Label text="Full Name"
                   styleClass="field-label"/>

            <TextField fx:id="nameField"
                       promptText="Your full name"
                       styleClass="input-field"/>

            <Label text="Email"
                   styleClass="field-label"/>

            <TextField fx:id="emailField"
                       promptText="your@email.com"
                       styleClass="input-field"/>

            <Label text="Phone Number"
                   styleClass="field-label"/>

            <TextField fx:id="phoneField"
                       promptText="+250 xxx xxx xxx"
                       styleClass="input-field"/>

            <Label text="PIN (4–6 digits)"
                   styleClass="field-label"/>

            <PasswordField fx:id="pinField"
                           promptText="Choose a secure PIN"
                           styleClass="input-field"/>

            <Label text="Confirm PIN"
                   styleClass="field-label"/>

            <PasswordField fx:id="confirmPinField"
                           promptText="Repeat your PIN"
                           styleClass="input-field"/>

            <Label fx:id="messageLabel"
                   styleClass="error-label"
                   wrapText="true"/>

            <Button text="Create Account"
                    onAction="#handleRegister"
                    maxWidth="Infinity"
                    styleClass="btn-primary"/>

            <Button text="← Back to Login"
                    onAction="#handleBack"
                    maxWidth="Infinity"
                    styleClass="btn-secondary"/>

        </VBox>

    </VBox>

</StackPane>