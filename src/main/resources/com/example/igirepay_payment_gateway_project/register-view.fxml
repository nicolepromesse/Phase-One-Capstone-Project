<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.igirepay.lab3.javafxui.RegisterController"
           stylesheets="@styles.css"
           styleClass="root-pane">

    <VBox alignment="CENTER"
          spacing="16"
          styleClass="login-card">

        <padding>
            <Insets top="40" right="48" bottom="40" left="48"/>
        </padding>

        <Label text="💳 IgirePay"
               styleClass="brand-title"/>

        <Label text="Create Account"
               styleClass="brand-sub"/>

        <Separator/>

        <VBox spacing="10">

            <Label text="Full Name"
                   styleClass="field-label"/>

            <TextField fx:id="nameField"
                       promptText="Your full name"
                       styleClass="input-field"/>

            <Label text="Email"
                   styleClass="field-label"/>

            <TextField fx:id="emailField"
                       promptText="your@email.com"
                       styleClass="input-field"/>

            <Label text="Phone Number"
                   styleClass="field-label"/>

            <TextField fx:id="phoneField"
                       promptText="+250 xxx xxx xxx"
                       styleClass="input-field"/>

            <Label text="PIN (4–6 digits)"
                   styleClass="field-label"/>

            <PasswordField fx:id="pinField"
                           promptText="Choose a secure PIN"
                           styleClass="input-field"/>

            <Label text="Confirm PIN"
                   styleClass="field-label"/>

            <PasswordField fx:id="confirmPinField"
                           promptText="Repeat your PIN"
                           styleClass="input-field"/>

            <Label fx:id="messageLabel"
                   wrapText="true"
                   styleClass="error-label"/>

            <Button text="Create Account"
                    onAction="#handleRegister"
                    maxWidth="Infinity"
                    styleClass="btn-primary"/>

            <Button text="← Back to Login"
                    onAction="#handleBack"
                    maxWidth="Infinity"
                    styleClass="btn-secondary"/>

        </VBox>

    </VBox>

</StackPane>