<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.igirepay.lab3.javafxui.PaymentController"
      spacing="12" style="-fx-padding: 20; -fx-font-size: 14;">

    <Label text="IgirePay — Payment Gateway" style="-fx-font-size: 18; -fx-font-weight: bold;"/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Account ID:" minWidth="130"/>
        <TextField fx:id="accountIdField" promptText="e.g. 1" prefWidth="120"/>
    </HBox>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="To Account ID:" minWidth="130"/>
        <TextField fx:id="toAccountIdField" promptText="For transfers only" prefWidth="120"/>
    </HBox>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Amount (RWF):" minWidth="130"/>
        <TextField fx:id="amountField" promptText="e.g. 5000" prefWidth="120"/>
    </HBox>

    <HBox spacing="10">
        <Button text="Deposit"       onAction="#onDeposit"      prefWidth="110"/>
        <Button text="Withdraw"      onAction="#onWithdraw"     prefWidth="110"/>
        <Button text="Transfer"      onAction="#onTransfer"     prefWidth="110"/>
        <Button text="Check Balance" onAction="#onCheckBalance" prefWidth="130"/>
        <Button text="View History"  onAction="#onViewHistory"  prefWidth="120"/>
    </HBox>

    <Label fx:id="statusLabel" text="" wrapText="true"/>

    <Label text="Transaction History:" style="-fx-font-weight: bold;"/>
    <TextArea fx:id="historyArea" editable="false" prefHeight="200" wrapText="true"/>

</VBox>
