<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.igirepay.lab3.javafxui.LoginController"
           stylesheets="@styles.css"
           styleClass="root-pane">

    <VBox styleClass="login-card"
          alignment="CENTER"
          spacing="20">

        <padding>
            <Insets top="48" right="48" bottom="48" left="48"/>
        </padding>

        <VBox alignment="CENTER" spacing="6">
            <Label text="💳" style="-fx-font-size:48px;"/>
            <Label text="IgirePay" styleClass="brand-title"/>
            <Label text="Digital Wallet Gateway" styleClass="brand-sub"/>
        </VBox>

        <Separator/>

        <VBox spacing="12">

            <Label text="PIN" styleClass="field-label"/>

            <PasswordField fx:id="pinField"
                           promptText="Enter your PIN"
                           styleClass="input-field"/>

            <Label fx:id="errorLabel"
                   styleClass="error-label"
                   wrapText="true"/>

            <Button text="Sign In"
                    onAction="#handleLogin"
                    styleClass="btn-primary"
                    maxWidth="Infinity"/>

            <Button text="Register New Customer"
                    onAction="#handleRegister"
                    styleClass="btn-secondary"
                    maxWidth="Infinity"/>

        </VBox>

    </VBox>

</StackPane>